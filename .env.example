# Copy to .env.local for local development against live Supabase data.
# Without these set, the dashboard falls back to the bundled data/films.csv snapshot.

SUPABASE_URL=
SUPABASE_KEY=

# Free API key from https://www.omdbapi.com/apikey.aspx — used to fetch movie
# posters for the roulette wheel and the case-opener. Without it, films fall
# back to a plain title card instead of a poster.
OMDB_API_KEY=
